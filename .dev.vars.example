# Copy to .dev.vars (git-ignored, mode 0600). create-feedbax writes the real file for you.
# Placeholders only: never commit real secrets.
PORTAL_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-32-random-bytes-base64url
FEEDBAX_HOST_SECRET=replace-with-32-random-bytes-base64url
NOTION_TOKEN=ntn_replace_me
# GitHub template only: fine-grained token, one repo, Issues read/write.
# GITHUB_TOKEN=github_pat_replace_me
# Optional release webhooks (reconciliation works without this).
# GITHUB_WEBHOOK_SECRET=replace-with-random-webhook-secret
# Sign-in uses GitHub, Google or your app's host integration; no email/password login.
# Set both credentials for a chosen provider; use a separate localhost OAuth app.
# Without a provider pair, configure appUrl and the host token endpoint to sign in.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional AI provider key for jev, gemini, or openai (local mode needs no key).
# AI_API_KEY=
