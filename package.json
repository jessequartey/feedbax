{
  "name": "@feedbax/workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "type-check": "turbo run check-types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "manual:setup:notion": "tsx scripts/manual-notion-setup.ts",
    "dev:portal": "turbo run dev -F @feedbax/portal",
    "dev:docs": "turbo run dev -F @feedbax/docs",
    "build:docs": "turbo run build -F @feedbax/docs",
    "deploy:docs": "pnpm --filter @feedbax/docs run deploy",
    "deploy:docs:dry-run": "pnpm --filter @feedbax/docs deploy:dry-run",
    "deploy:dry-run": "pnpm --filter @feedbax/portal deploy:dry-run",
    "changeset": "changeset",
    "release:version": "changeset version && pnpm template:sync",
    "release:publish": "node scripts/publish-packages.mjs",
    "template:sync": "tsx scripts/assemble-template.ts",
    "template:check": "tsx scripts/assemble-template.ts --check",
    "packages:check": "tsx scripts/check-packages.ts",
    "security:check": "node scripts/check-secrets.mjs",
    "registry:build": "node scripts/build-registry.mjs"
  },
  "dependencies": {
    "@feedbax/env": "workspace:*",
    "dotenv": "catalog:",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "10.0.1",
    "@feedbax/config": "workspace:*",
    "@shadcn/lint": "^0.2.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "catalog:",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "4.23.15",
    "turbo": "2.11.8",
    "typescript": "catalog:",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
