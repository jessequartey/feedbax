{
  "name": "feedbax",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "content:generate": "pnpm --filter @feedbax/site exec fumadocs-mdx source.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "turbo run type-check",
    "lint": "turbo run lint",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "turbo run test",
    "test:e2e": "playwright test --config playwright.e2e.config.ts",
    "test:notion-smoke": "playwright test --config playwright.notion.config.ts",
    "test:a11y": "playwright test tests/accessibility.spec.ts --config playwright.config.ts",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:pack": "pnpm --filter create-feedbax pack && pnpm --filter feedbax pack && pnpm --filter @feedbax/core pack && pnpm --filter @feedbax/notion pack && pnpm --filter @feedbax/auth-handoff pack",
    "notion:doctor": "pnpm turbo run build --filter=@feedbax/notion --filter=@feedbax/config && node scripts/notion-doctor.mjs",
    "notion:prepare-smoke": "node scripts/prepare-notion-smoke.mjs",
    "notion:provision": "node scripts/provision-notion.mjs",
    "notion:seed-dogfood": "node scripts/seed-dogfood.mjs",
    "dev": "turbo run dev --parallel",
    "clean:cache": "turbo daemon clean && rm -rf .turbo"
  },
  "dependencies": {
    "@feedbax/config": "workspace:*"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.61.1",
    "eslint": "10.0.1",
    "globals": "17.4.0",
    "prettier": "3.9.5",
    "turbo": "2.10.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "4.1.0"
  }
}
