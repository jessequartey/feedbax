{
  "name": "feedbax",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "type-check": "turbo run check-types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "dev:portal": "turbo run dev -F @feedbax/portal",
    "deploy:dry-run": "pnpm --filter @feedbax/portal deploy:dry-run"
  },
  "dependencies": {
    "@feedbax/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@feedbax/config": "workspace:*",
    "@types/node": "catalog:",
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "turbo": "2.10.11",
    "typescript": "catalog:",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.29.3"
}
