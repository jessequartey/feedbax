{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feedbax-feedback",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/cloudflare-entry.ts",
  "observability": { "enabled": true },
  "vars": {
    "FEEDBAX_PUBLIC_URL": "https://feedbax-feedback.jessefquartey.workers.dev",
    "FEEDBAX_RATE_LIMIT_STORE": "cloudflare",
    "FEEDBAX_IDENTITY_MODE": "email",
  },
  "durable_objects": {
    "bindings": [
      { "name": "FEEDBAX_RATE_LIMITER", "class_name": "FeedbaxRateLimiter" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FeedbaxRateLimiter"] }],
}
