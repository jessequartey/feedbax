{
  "name": "@feedbax/portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir ../.. notion:doctor && vite dev --port 3000",
    "build": "vite build",
    "build:cloudflare": "vite build --config vite.cloudflare.config.ts",
    "deploy:cloudflare": "pnpm build:cloudflare && wrangler deploy",
    "start": "pnpm --dir ../.. notion:doctor && node .output/server/index.mjs",
    "smoke": "node scripts/smoke.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint src scripts *.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@feedbax/config": "workspace:*",
    "@feedbax/notion": "workspace:*",
    "@feedbax/ui": "workspace:*",
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-start": "1.168.27",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.44.0",
    "@tanstack/router-plugin": "1.168.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "nitro": "3.0.260610-beta",
    "vite": "7.3.6",
    "wrangler": "4.110.0"
  }
}
