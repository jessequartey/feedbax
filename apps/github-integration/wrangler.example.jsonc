{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feedbax-github-integration-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "SERVICE_ORIGIN": "https://feedbax-github-integration-example.your-account.workers.dev",
    "TRUSTED_PORTAL_ORIGINS": "[]",
  },
  "d1_databases": [
    {
      "binding": "FEEDBAX_APP_DB",
      "database_name": "feedbax-github-integration-example",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "PAIRING_RATE_LIMITER",
      "namespace_id": "3001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "INTEGRATION_DELIVERY_QUEUE",
        "queue": "feedbax-github-delivery",
      },
    ],
    "consumers": [
      {
        "queue": "feedbax-github-delivery",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 10,
        "retry_delay": 60,
      },
    ],
  },
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": false },
}
