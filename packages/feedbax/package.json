    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "esbuild": "0.28.1"
  },
  "description": "Notion-native feedback portal lifecycle CLI",
