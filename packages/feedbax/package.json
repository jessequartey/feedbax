{
  "name": "feedbax",
  "version": "0.2.0",
  "type": "module",
  "bin": {
    "feedbax": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "4.1.11"
  },
  "scripts": {
