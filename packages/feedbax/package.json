{
  "name": "feedbax",
  "version": "0.2.2",
  "type": "module",
  "bin": {
    "feedbax": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "5.0.4"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --external:esbuild --outfile=dist/cli.js --external:jsonc-parser && node scripts/package-upgrade-template.mjs",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "esbuild": "0.28.2"
  },
  "description": "Deployer lifecycle CLI for a self-hosted Feedbax feedback portal",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jessequartey/feedbax.git",
    "directory": "packages/feedbax"
  },
  "homepage": "https://feedbax.dev/docs",
  "bugs": {
    "url": "https://github.com/jessequartey/feedbax/issues"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
