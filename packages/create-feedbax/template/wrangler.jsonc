{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feedbax-installation",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./src/server.ts",
  "workers_dev": true,
  "preview_urls": true,
  "cache": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "TRUSTED_SUBMISSIONS_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "PORTAL_SUBMISSIONS_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
